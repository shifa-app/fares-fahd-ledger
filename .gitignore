# Symbolication related
app.*.symbols

# Signing keystores must never be committed (the repo is public).
# The release build signs with the pinned debug keystore in
# android/debug.keystore — see android/app/build.gradle.kts.
*.keystore

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local machine-specific files (never commit)
.gradle-home/
android/.gradle/
android/build/
android/local.properties
docs/github-release/

# Widget Preview related
.widget_preview/
